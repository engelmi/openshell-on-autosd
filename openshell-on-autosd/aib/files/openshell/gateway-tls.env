# OpenShell Gateway Environment Configuration
OPENSHELL_GATEWAY_CONFIG=/etc/openshell/config/gateway-tls.toml

OPENSHELL_LOG_LEVEL=debug
OPENSHELL_BIND_ADDRESS=0.0.0.0
OPENSHELL_DRIVERS=podman
OPENSHELL_DB_URL=sqlite:///var/lib/openshell/openshell-gateway.db
OPENSHELL_SUPERVISOR_IMAGE=ghcr.io/nvidia/openshell/supervisor:14c5329f91d8f7c60e6274465bb1e246156074e7
OPENSHELL_SANDBOX_IMAGE=ghcr.io/nvidia/openshell-community/sandboxes/base:db19652

# mTLS: auto-generated certs in the state directory.
OPENSHELL_TLS_CERT=/etc/openshell/state/tls/server/tls.crt
OPENSHELL_TLS_KEY=/etc/openshell/state/tls/server/tls.key
OPENSHELL_TLS_CLIENT_CA=/etc/openshell/state/tls/ca.crt
# Podman driver: client certs bind-mounted into sandbox containers.
OPENSHELL_PODMAN_TLS_CA=/etc/openshell/state/tls/ca.crt
OPENSHELL_PODMAN_TLS_CERT=/etc/openshell/state/tls/client/tls.crt
OPENSHELL_PODMAN_TLS_KEY=/etc/openshell/state/tls/client/tls.key
