HOME=/etc/openshell
XDG_CONFIG_HOME=/etc/openshell/config
XDG_STATE_HOME=/etc/openshell/state
XDG_RUNTIME_DIR=/run

# OpenShell Gateway Environment Configuration
OPENSHELL_GATEWAY_CONFIG=/etc/openshell/gateway.toml

OPENSHELL_LOG_LEVEL=debug
OPENSHELL_BIND_ADDRESS=0.0.0.0
OPENSHELL_SERVER_PORT=8080
OPENSHELL_DRIVERS=podman
OPENSHELL_DB_URL=sqlite:///var/lib/openshell/openshell-gateway.db
OPENSHELL_SUPERVISOR_IMAGE=ghcr.io/nvidia/openshell/supervisor:0.0.65
OPENSHELL_SANDBOX_IMAGE=ghcr.io/nvidia/openshell-community/sandboxes/base:latest

# Set TLS env variables empty to disable it and allow unauthenticated users
OPENSHELL_DISABLE_TLS=true
OPENSHELL_ALLOW_UNAUTHENTICATED_USERS=true

OPENSHELL_LOCAL_TLS_DIR=/etc/openshell/state/tls
